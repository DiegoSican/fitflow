@'
# ==========================================
# FitFlow - Variables de entorno de ejemplo
# ==========================================

# Users Service Database
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=change_me_users
USERS_DB_HOST=users-db
USERS_DB_PORT=5432

# Booking Service Database
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=change_me_booking
BOOKING_DB_HOST=booking-db
BOOKING_DB_PORT=5432

# Notification Service Database
NOTIF_DB_NAME=notif_db
NOTIF_DB_USER=notif_user
NOTIF_DB_PASSWORD=change_me_notif
NOTIF_DB_HOST=notif-db
NOTIF_DB_PORT=5432

# JWT
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
'@ | Set-Content .env.example